# Docker Compose loads .env automatically. Python/PowerShell use environment variables.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
SRE_BENCH_PATH=C:/path/to/sre-bench
ENABLE_CLOUD_MODEL=false
LLM_MODEL=kimi-k3.1-pro
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LANGSMITH_TRACING=false
COOKIE_SECURE=false

# Generate fresh secrets before enabling integrations.
MCP_SERVICE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LF_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
ENABLE_JUDGES=false

RAG_MODEL_PATH=C:/path/to/rag-models
MCP_URL=http://mcp:8090/mcp
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=incident-project

JUDGE_A_MODEL=
JUDGE_A_BASE_URL=
JUDGE_A_API_KEY=
JUDGE_B_MODEL=
JUDGE_B_BASE_URL=
JUDGE_B_API_KEY=
